{
	"status": true,
	"values": {
		"enable_plugin": true,
		"notice_content": "<p>Our <strong>website</strong> uses cookies to provide you with the best experience. However, by continuing to use our website, you agree to our use of cookies. For more information, please read our <a href='#'>cookie policy</a>.</p>",
		"cookie_expiry": 1,
		"accept_button_label": "Accept",
		"display_close_button": false,
		"display_cookie_icon": true,
		"layout": "custom",
		"notice_width": 450,
		"enable_background_overlay": true,
		"overlay_background_color": "rgba(0, 0, 0, 0.8)",
		"full_width_notice_position": "bottom",
		"custom_width_notice_position": "bottom-right",
		"custom_width_notice_position_offset": {
			"top-left-offset": 31,
			"top-offset": 32,
			"top-right-offset": 33,
			"bottom-left-offset": 30,
			"bottom-offset": 40,
			"bottom-right-offset": 20
		},
		"notice_background_color": "#fde047",
		"cookie_icon_color": "#1f2937",
		"text_color": "#1f2937",
		"link_color": "#3f3f46",
		"link_hover_color": "#1f2937",
		"accept_button_background_color": "#1f2937",
		"accept_button_hover_background_color": "#3f3f46",
		"accept_button_label_color": "#FFFFFF",
		"accept_button_hover_label_color": "#FFFFFF",
		"accept_button_border_color": "rgba(255, 255, 255, 0)",
		"accept_button_hover_border_color": "rgba(255, 255, 255, 0)",
		"close_button_background_color": "#3f3f46",
		"close_button_hover_background_color": "#1f2937",
		"close_button_label_color": "#FFFFFF",
		"close_button_hover_label_color": "#FFFFFF",
		"custom_css": ""
	},
	"sections": {
		"basic": {
			"section_title": "Basic options",
			"doc_link": "https://docs.addonify.com",
			"fields": {
				"enable_plugin": {
					"type": "switch",
					"label": "Enable cookie notice",
					"description": "Enable this option to activate cookie notice."
				},
				"cookie_expiry": {
					"type": "number",
					"label": "Cookie expiry duration",
					"unit": "Days",
					"min": 0,
					"max": 365,
					"step": 1,
					"description": "Set how long the notice should be hidden after the user accepts it. If you prefer to have a session cookie, set this to 0."
				},
				"notice_content": {
					"type": "editor",
					"label": "Cookie notice message",
					"description": "Actual content of the notice.",
					"full_width": true
				},
				"display_cookie_icon": {
					"type": "switch",
					"label": "Display cookie icon in the notice"
				}
			}
		},
		"layout": {
			"section_title": "Layout options",
			"fields": {
				"layout": {
					"type": "radio",
					"label": "Notice layout",
					"description": "Choose how should the notice be look on the website.",
					"full_width": true,
					"choices": {
						"custom": "Custom width",
						"full": "Full width bar",
						"popup": "Popup"
					}
				},
				"notice_width": {
					"type": "number",
					"label": "Notice width",
					"unit": "Pixels",
					"min": 300,
					"max": 1400,
					"step": 5,
					"description": "Specify the width of the notice.",
					"dependent": {
						"layout": [
							"popup",
							"custom"
						]
					}
				},
				"enable_background_overlay": {
					"type": "switch",
					"label": "Enable overlay mask background",
					"description": "Mask is a background color that is visible below the popup notice.",
					"dependent": {
						"layout": "popup"
					}
				},
				"full_width_notice_position": {
					"type": "select",
					"label": "Position of the notice",
					"description": "Select where the notice should appear in the website.",
					"choices": {
						"top": "Top",
						"bottom": "Bottom"
					},
					"dependent": {
						"layout": "full_width"
					}
				},
				"overlay_background_color": {
					"type": "color",
					"label": "Overlay background color",
					"dependent": {
						"layout": "popup",
						"enable_background_overlay": true
					}
				},
				"custom_width_notice_position": {
					"type": "select",
					"label": "Position of the notice",
					"description": "Select where the notice should appear in the website.",
					"choices": {
						"top-left": "Top left",
						"top-center": "Top center",
						"top-right": "Top right",
						"bottom-left": "Bottom left",
						"bottom-center": "Bottom center",
						"bottom-right": "Bottom right"
					},
					"dependent": {
						"layout": "custom"
					}
				},
				"custom_width_notice_position_offset": {
					"type": "position",
					"label": "Notice position offset (in pixels)",
					"choices": {
						"top-left-offset": 30,
						"top-offset": 30,
						"top-right-offset": 30,
						"bottom-left-offset": 30,
						"bottom-offset": 30,
						"bottom-right-offset": 30
					},
					"dependent": {
						"layout": "custom"
					}
				},
				"notice_background_color": {
					"type": "color",
					"label": "Notice background color"
				},
				"cookie_icon_color": {
					"type": "color",
					"label": "Cookie icon color"
				},
				"text_color": {
					"type": "color",
					"label": "Text color inside the notice"
				},
				"link_color": {
					"type": "color",
					"label": "Link color inside the notice"
				},
				"link_hover_color": {
					"type": "color",
					"label": "Link color on hover inside the notice"
				}
			}
		},
		"buttons": {
			"section_title": "Button options",
			"fields": {
				"accept_button_label": {
					"type": "text",
					"label": "Accept button label"
				},
				"display_close_button": {
					"type": "switch",
					"label": "Display close button"
				},
				"accept_button_background_color": {
					"type": "color",
					"label": "Accept button background color"
				},
				"accept_button_hover_background_color": {
					"type": "color",
					"label": "Accept button background color on hover"
				},
				"accept_button_label_color": {
					"type": "color",
					"label": "Accept button label color"
				},
				"accept_button_hover_label_color": {
					"type": "color",
					"label": "Accept button label color on hover"
				},
				"accept_button_border_color": {
					"type": "color",
					"label": "Accept button border color"
				},
				"accept_button_hover_border_color": {
					"type": "color",
					"label": "Accept button border color on hover"
				},
				"close_button_background_color": {
					"type": "color",
					"label": "Close button background color"
				},
				"close_button_hover_background_color": {
					"type": "color",
					"label": "Close button background color on hover"
				},
				"close_button_label_color": {
					"type": "color",
					"label": "Close button label color"
				},
				"close_button_hover_label_color": {
					"type": "color",
					"label": "Close button label color on hover"
				}
			}
		},
		"developer": {
			"section_title": "Developer",
			"fields": {
				"custom_css": {
					"type": "textarea",
					"label": "Custom CSS",
					"description": "Add your custom CSS below if you want to style the notice further.",
					"placeholder": ".app { background-color: #fde047; }",
					"full_width": true
				}
			}
		}
	}
}