	"sections": {
		"basic": {
			"section_title": "Basic options",
			"doc_link": "https://docs.addonify.com",
			"fields": {
				"enable_plugin": {
					"type": "switch",
					"label": "Enable cookie notice",
					"description": "Enable this option to activate cookie notice."
				},
				"cookie_expiry": {
					"type": "number",
					"label": "Cookie expiry duration",
					"unit": "days",
					"min": 0,
					"max": 365,
					"step": 2,
					"description": "Set how long the notice should be hidden after the user accepts it. Set to 0 to show the notice every time the page is loaded."
				},
				"notice_content": {
					"type": "editor",
					"label": "Cookie notice message",
					"description": "Actual content of the notice."
				},
				"display_cookie_icon": {
					"type": "switch",
					"label": "Display cookie icon in the notice"
				}
			}
		},
		"layout": {
			"section_title": "Layout options",
			"fields": {
				"layout": {
					"type": "radio",
					"label": "Notice layout",
					"description": "Choose how should the notice be look on the website.",
					"full_width": true,
					"choices": {
						"custom": "Custom width",
						"bar": "Bar",
						"popup": "Popup"
					}
				},
				"popup_width": {
					"type": "number",
					"label": "Popup width",
					"unit": "px",
					"min": -5,
					"max": 1400,
					"step": 5,
					"description": "Specify the width of the popup notice in pixels.",
					"dependent": [
						"layout"
					]
				},
				"notice_background_color": {
					"type": "color",
